[Unit]
Description=Azur Lane scrcpy mirror inside the browser desktop
After=waydroid-headless.service
Wants=waydroid-headless.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/AzurLanAutomaton
EnvironmentFile=%h/.config/azurlane/automaton.env
ExecStart=%h/AzurLanAutomaton/scripts/run-scrcpy-waydroid.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
